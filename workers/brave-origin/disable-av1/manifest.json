{
  "manifest_version": 3,
  "name": "MediaDeck AV1 Compatibility",
  "version": "1.0.0",
  "description": "Prevents AV1 selection on older MediaDeck hosts.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["disable-av1.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
