# Host port exposed only on loopback. Tailscale Serve proxies to this port.
MEDIADECK_PORT=8080
# Optional: use compose.lan.yaml and set this to the server's reserved LAN IP.
# Do not use 0.0.0.0; an explicit address avoids publishing on every interface.
# MEDIADECK_LAN_ADDRESS=192.168.1.50
MEDIADECK_DATA_VOLUME=mediadeck-data
# Release deployments may set a digest-pinned image and HTTPS manifest.
MEDIADECK_IMAGE=mediadeck:0.1.0
MEDIADECK_UPDATE_MANIFEST_URL=

# Values passed into the production container by Compose.
APP_VERSION=0.1.0
LOG_LEVEL=info
TRUST_PROXY=false
# Keep true behind Tailscale Serve. Direct LAN HTTP requires false so the
# browser can return the path-scoped stream cookie over HTTP.
SESSION_COOKIE_SECURE=true

# Dynamic Brave Origin worker settings.
BROWSER_START_URL=https://www.youtube.com/
BROWSER_FRAMERATE=30
BROWSER_VIDEO_BITRATE=6
BROWSER_SESSION_HEALTH_INTERVAL_SECONDS=15
BROWSER_SESSION_IDLE_TIMEOUT_SECONDS=1800
MAX_BROWSER_SESSIONS=1
BROWSER_WORKER_CPUS=2
BROWSER_WORKER_MEMORY_MB=2048
BROWSER_WORKER_PIDS_LIMIT=512
BROWSER_WORKER_SHM_MB=1024
BROWSER_WORKER_GPU_MODE=auto
BROWSER_WORKER_IMAGE=mediadeck-brave-origin:0.1.0
# Broadwell/Haswell Intel: i965. Newer Intel: iHD. AMD and unknown hosts: auto.
BROWSER_VAAPI_DRIVER=auto
BROWSER_WORKER_NETWORK=mediadeck_default
# Must remain 1000 so the app and Brave Origin share profile-volume ownership.
PUID=1000
PGID=1000
# Set this to the group ID that owns /var/run/docker.sock on the Linux host.
DOCKER_GID=0
TZ=Etc/UTC

# Linux Intel/AMD render node mounted into dynamic browser workers.
BROWSER_DRI_DEVICE=/dev/dri/renderD128
