# Host port exposed only on loopback. Tailscale Serve proxies to this port.
MEDIADECK_PORT=8080

# Values passed into the production container by Compose.
APP_VERSION=0.1.0
LOG_LEVEL=info
TRUST_PROXY=false

# Stage 2 browser worker. Both ports stay loopback-only; use HTTPS through the
# trusted reverse proxy in production.
BROWSER_SPIKE_HTTP_PORT=3002
BROWSER_SPIKE_HTTPS_PORT=3003
BROWSER_START_URL=https://www.youtube.com/
BROWSER_FRAMERATE=60
BROWSER_VIDEO_BITRATE=12
PUID=1000
PGID=1000
TZ=Etc/UTC

# Linux-only optional Intel/AMD render node for compose.browser-gpu.yaml.
BROWSER_DRI_DEVICE=/dev/dri/renderD128
