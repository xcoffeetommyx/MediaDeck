# Host port exposed only on loopback. Tailscale Serve proxies to this port.
MEDIADECK_PORT=8080
MEDIADECK_DATA_VOLUME=mediadeck-data
# Release deployments may set a digest-pinned image and HTTPS manifest.
MEDIADECK_IMAGE=mediadeck:0.1.0
MEDIADECK_UPDATE_MANIFEST_URL=

# Values passed into the production container by Compose.
APP_VERSION=0.1.0
FIREFOX_MAJOR_VERSION=153
LOG_LEVEL=info
TRUST_PROXY=false
# Keep true behind Tailscale Serve. Set false only for direct local HTTP testing.
SESSION_COOKIE_SECURE=true

# Managed Firefox add-ons. Watched packages go in:
# /data/addons/inbox/<profile-uuid>/*.xpi
ADDON_MAX_PACKAGE_MB=25
ADDON_WATCH_ENABLED=false
ADDON_WATCH_INTERVAL_SECONDS=60

# Stage 2 browser worker. Both ports stay loopback-only; use HTTPS through the
# trusted reverse proxy in production.
BROWSER_SPIKE_HTTP_PORT=3002
BROWSER_SPIKE_HTTPS_PORT=3003
BROWSER_START_URL=https://www.youtube.com/
BROWSER_FRAMERATE=60
BROWSER_VIDEO_BITRATE=12
BROWSER_SESSION_HEALTH_INTERVAL_SECONDS=15
BROWSER_SESSION_IDLE_TIMEOUT_SECONDS=1800
MAX_BROWSER_SESSIONS=1
BROWSER_WORKER_CPUS=2
BROWSER_WORKER_MEMORY_MB=2048
BROWSER_WORKER_PIDS_LIMIT=512
BROWSER_WORKER_SHM_MB=1024
BROWSER_WORKER_GPU_MODE=software
BROWSER_WORKER_NETWORK=mediadeck_default
# Must remain 1000 so the app and Firefox share profile-volume ownership.
PUID=1000
PGID=1000
# Set this to the group ID that owns /var/run/docker.sock on the Linux host.
DOCKER_GID=0
TZ=Etc/UTC

# Linux-only optional Intel/AMD render node for compose.browser-gpu.yaml.
BROWSER_DRI_DEVICE=/dev/dri/renderD128
